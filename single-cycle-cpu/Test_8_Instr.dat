00f00093 // 0x00: addi x1, x0, 15    (x1 = 15)
00500113 // 0x04: addi x2, x0, 5     (x2 = 5)
ff600193 // 0x08: addi x3, x0, -10   (x3 = -10, 即 0xFFFFFFF6)
00208233 // 0x0c: add  x4, x1, x2    (x4 = 15 + 5 = 20, 即 0x14)
402082b3 // 0x10: sub  x5, x1, x2    (x5 = 15 - 5 = 10, 即 0x0A)
00209333 // 0x14: sll  x6, x1, x2    (x6 = 15 << 5 = 480, 即 0x1E0)
0011a3b3 // 0x18: slt  x7, x3, x1    (x7 = -10 < 15 ? 1 : 0 = 1)
0011b433 // 0x1c: sltu x8, x3, x1    (x8 = 无符号 -10 < 15 ? 1 : 0 = 0)
0020c4b3 // 0x20: xor  x9, x1, x2    (x9 = 15 ^ 5 = 10, 即 0x0A)
0020d533 // 0x24: srl  x10, x1, x2   (x10= 15 >> 5 = 0)
4021d5b3 // 0x28: sra  x11, x3, x2   (x11= -10 算术右移 5位 = -1, 即 0xFFFFFFFF)
0020e633 // 0x2c: or   x12, x1, x2   (x12= 15 | 5 = 15, 即 0x0F)
0020f6b3 // 0x30: and  x13, x1, x2   (x13= 15 & 5 = 5, 即 0x05)
00000013 // 0x34: nop
00000013 // 0x38: nop
00000013 // 0x3c: nop
00000013 // 0x40: nop
00000013 // 0x44: nop
00000013 // 0x48: nop (触发结束)