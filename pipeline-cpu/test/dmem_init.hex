// dmem_init.hex
// 扫描码 → ASCII 转换表 (256字节 = 64个32位字)
// 每行一个32位字，字节顺序: [addr+3][addr+2][addr+1][addr+0]
// PS/2 Set 1 扫描码映射

// 0x00-0x0F: 控制键 (大部分为0)
00000000  // 0x00-0x03: 无定义
00000000  // 0x04-0x07: 无定义
00000000  // 0x08-0x0B: 无定义
00090000  // 0x0C-0x0F: 0x0D=Tab(0x09)

// 0x10-0x1F: 数字1-9, Q-Y行
61000000  // 0x10-0x13: 0x1C='a'(0x61)
00000000  // 0x14-0x17: 0x15='q'(0x71), 0x16='1'(0x31)
00000031  // 0x18-0x1B: 0x1A='z'(0x7A), 0x1B='s'(0x73)
00737A00  // 0x1C-0x1F: 0x1D='w'(0x77), 0x1E='2'(0x32)

// 0x20-0x2F: E-N行
71327700  // 0x20-0x23: 0x20='q'(0x71), 0x21='c'(0x63), 0x22='x'(0x78), 0x23='d'(0x64)
34647863  // 0x24-0x27: 0x24='e'(0x65), 0x25='4'(0x34), 0x26='3'(0x33)
20003365  // 0x28-0x2B: 0x28='`'(0x60), 0x29=Space(0x20), 0x2A='v'(0x76), 0x2B='f'(0x66)
74762060  // 0x2C-0x2F: 0x2C='t'(0x74), 0x2D='r'(0x72), 0x2E='5'(0x35)

// 0x30-0x3F: U-M行
00357274  // 0x30-0x33: 0x30='u'(0x75), 0x31='n'(0x6E), 0x32='b'(0x62), 0x33='h'(0x68)
68626E75  // 0x34-0x37: 0x34='g'(0x67), 0x35='y'(0x79), 0x36='6'(0x36)
006D6A00  // 0x38-0x3B: 0x38=无, 0x39='m'(0x6D), 0x3A=无, 0x3B='j'(0x6A)
6B383775  // 0x3C-0x3F: 0x3C='u'(0x75), 0x3D='7'(0x37), 0x3E='8'(0x38), 0x3F='k'(0x6B)

// 0x40-0x4F: I-P行
00000000  // 0x40: 无
00692C00  // 0x44-0x47: 0x41=','(0x2C), 0x42='k'(0x6B), 0x43='i'(0x69), 0x44='o'(0x6F)
00306F00  // 0x48-0x4B: 0x45='0'(0x30), 0x46='9'(0x39), 0x47='.'(0x2E)
703B6C2E  // 0x4C-0x4F: 0x48='/'(0x2F), 0x49='l'(0x6C), 0x4A=';'(0x3B), 0x4B='p'(0x70)

// 0x50-0x5F: Enter等
002D0000  // 0x50-0x53: 0x4D='p'(0x70), 0x4E='-'(0x2D)
00002700  // 0x54-0x57: 0x52='''(0x27), 0x53=无
00000000  // 0x58-0x5B: 0x54='['(0x5B), 0x55='='(0x3D)
005D0A00  // 0x5C-0x5F: 0x5A=Enter(0x0A), 0x5B=']'(0x5D)

// 0x60-0x6F: Backspace等
00000000  // 0x60-0x63: 0x5D='\'(0x5C)
00000800  // 0x64-0x67: 0x66=Backspace(0x08)
00000000  // 0x68-0x6B: 0x69=Keypad1(0x31)
00000000  // 0x6C-0x6F: 0x6B=Keypad4(0x34), 0x6C=Keypad7(0x37)

// 0x70-0x7F: 小键盘
00000000  // 0x70-0x73: 0x70=Keypad0(0x30)
00000000  // 0x74-0x77: 0x72=Keypad2(0x32), 0x73=Keypad5(0x35)
00000000  // 0x78-0x7B: 0x75=Keypad8(0x38)
002B0000  // 0x7C-0x7F: 0x79='+'(0x2B), 0x7A=Keypad3(0x33), 0x7B='-'(0x2D), 0x7C='*'(0x2A)

// 0x80-0xFF: 未定义 (全0)
00000000  // 0x80-0x83
00000000  // 0x84-0x87
00000000  // 0x88-0x8B
00000000  // 0x8C-0x8F
00000000  // 0x90-0x93
00000000  // 0x94-0x97
00000000  // 0x98-0x9B
00000000  // 0x9C-0x9F
00000000  // 0xA0-0xA3
00000000  // 0xA4-0xA7
00000000  // 0xA8-0xAB
00000000  // 0xAC-0xAF
00000000  // 0xB0-0xB3
00000000  // 0xB4-0xB7
00000000  // 0xB8-0xBB
00000000  // 0xBC-0xBF
00000000  // 0xC0-0xC3
00000000  // 0xC4-0xC7
00000000  // 0xC8-0xCB
00000000  // 0xCC-0xCF
00000000  // 0xD0-0xD3
00000000  // 0xD4-0xD7
00000000  // 0xD8-0xDB
00000000  // 0xDC-0xDF
00000000  // 0xE0-0xE3
00000000  // 0xE4-0xE7
00000000  // 0xE8-0xEB
00000000  // 0xEC-0xEF
00000000  // 0xF0-0xF3
00000000  // 0xF4-0xF7
00000000  // 0xF8-0xFB
00000000  // 0xFC-0xFF
