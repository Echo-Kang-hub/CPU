// scan2ascii.hex - 正确的PS/2 Set 1映射

// 0x00-0x0F
00 00 00 00 00 00 00 00 00 00 00 00 00 09 60 00

// 0x10-0x1F: 0x15=q, 0x16=1, 0x1A=z, 0x1B=s, 0x1C=a, 0x1D=w, 0x1E=2
00 00 00 00 00 71 31 00 00 00 7A 73 61 77 32 00

// 0x20-0x2F: 0x21=c, 0x22=x, 0x23=d, 0x24=e, 0x25=4, 0x26=3, 0x29=space, 0x2A=v, 0x2B=f, 0x2C=t, 0x2D=r, 0x2E=5
00 63 78 64 65 34 33 00 00 20 76 66 74 72 35 00

// 0x30-0x3F: 0x31=n, 0x32=b, 0x33=h, 0x34=g, 0x35=y, 0x36=6, 0x3A=m, 0x3B=j, 0x3C=u, 0x3D=7, 0x3E=8
00 6E 62 68 67 79 36 00 00 00 6D 6A 75 37 38 00

// 0x40-0x4F: 0x41=,, 0x42=k, 0x43=i, 0x44=o, 0x45=0, 0x46=9, 0x49=., 0x4A=/, 0x4B=l, 0x4C=;, 0x4D=p, 0x4E=-
00 2C 6B 69 6F 30 39 00 00 2E 2F 6C 3B 70 2D 00

// 0x50-0x5F: 0x52=', 0x54=[, 0x55==, 0x5A=Enter, 0x5B=], 0x5D=\
00 00 27 00 5B 3D 00 00 00 00 0A 5D 00 5C 00 00

// 0x60-0x6F: 0x66=Backspace, 0x69=1, 0x6B=4, 0x6C=7
00 00 00 00 00 00 08 00 00 31 00 34 37 00 00 00

// 0x70-0x7F: 0x70=0, 0x71=., 0x72=2, 0x73=5, 0x74=6, 0x75=8, 0x76=Esc, 0x79=+, 0x7A=3, 0x7B=-, 0x7C=*, 0x7D=9
30 2E 32 35 36 38 1B 00 00 2B 33 2D 2A 39 00 00

// 0x80-0xFF
00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
